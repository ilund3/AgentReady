# Copy these into Railway (Dashboard → your service → Variables), or run scripts/railway-setup.sh
# after linking the project with: railway link
#
# Required (Railway sets PORT automatically; add Postgres plugin and reference its URL):
# - DATABASE_URL  → In Railway: add Postgres plugin, then add variable: DATABASE_URL = ${{Postgres.DATABASE_URL}}
#
# Required for app to run in cloud mode (no Docker on host):
IS_CLOUD=true
NODE_ENV=production
#
# Required for auth (generate one: openssl rand -base64 32):
BETTER_AUTH_SECRET=your-32-char-secret-here
#
# Required for GitHub App integration (use your Railway app URL, e.g. https://yourapp.up.railway.app):
NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app
#
# Optional:
# USER_ADMIN_ID=your-user-id   # if you want a specific user to be admin
