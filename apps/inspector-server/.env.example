# Comma-separated browser origins allowed to use the proxy (DNS rebinding protection).
# Required when the MCP Inspector UI is opened from a host other than localhost, e.g.:
# ALLOWED_ORIGINS=https://agentready.up.railway.app
ALLOWED_ORIGINS=

# Optional: fixed auth token (otherwise random token is printed on startup)
# MCP_PROXY_AUTH_TOKEN=

# Optional: listen port (default 6277)
# SERVER_PORT=6277
